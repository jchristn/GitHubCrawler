<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<Version>1.2.1</Version>
		<Nullable>enable</Nullable>
		<ApplicationIcon>logo.ico</ApplicationIcon>
		<GenerateDocumentationFile>True</GenerateDocumentationFile>
		<DocumentationFile>GitHubCrawler.xml</DocumentationFile>
		<Title>GitHubCrawler</Title>
		<Authors>Joel Christner</Authors>
		<Description>GitHubCrawler allows you to crawl GitHub repositories, enumerating code and other files, and download assets.</Description>
		<Copyright>(c)2025 Joel Christner</Copyright>
		<PackageProjectUrl>https://github.com/jchristn/GitHubCrawler</PackageProjectUrl>
		<PackageIcon>logo.png</PackageIcon>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/jchristn/GitHubCrawler</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageTags>git github crawl crawler http rest download opentelemetry telemetry metrics tracing</PackageTags>
		<PackageReleaseNotes>1.2.1: test dependency updates, no library changes. 1.2.0: Specific exception types (GitHubCrawlerException, GitHubRepositoryNotFoundException, GitHubRateLimitException), configurable ApiBaseUrl and UserAgent, nullable annotations, file download responses disposed, Inputty dependency removed. Built-in telemetry since 1.1.0; see TELEMETRY.md.</PackageReleaseNotes>
		<PackageLicenseFile>LICENSE.md</PackageLicenseFile>
		<IncludeSymbols>True</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
	</PropertyGroup>

	<ItemGroup>
	  <Content Include="logo.ico" />
	</ItemGroup>

	<ItemGroup>
	  <None Include="..\..\assets\logo.png">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\LICENSE.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	  <None Include="..\..\README.md">
	    <Pack>True</Pack>
	    <PackagePath>\</PackagePath>
	  </None>
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="System.Diagnostics.DiagnosticSource" Version="10.0.12" />
	</ItemGroup>

	<ItemGroup>
	  <None Update="GitHubCrawler.xml">
	    <CopyToOutputDirectory>Always</CopyToOutputDirectory>
	  </None>
	</ItemGroup>

</Project>
